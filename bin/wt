#!/usr/bin/env bash
# Create a git worktree for a branch, set it up, and open it as a herdr
# workspace. Bound to a herdr popup key.
#   bare-layout repo: <repo>/<branch>
#   normal repo:      <repo>/.worktrees/<branch> (kept out of git via info/exclude)
set -uo pipefail

fail() {
  echo "error: $*"
  read -rp "press enter to close" _
  exit 1
}

# branch names for the picker; typing a new name in it creates one
#   local:  local branches, minus ones whose upstream was deleted on origin
#   online: branches on origin
#   all:    both
list_branches() {
  case $1 in
    local) git for-each-ref --format='%(upstream:track)%09%(refname:short)' refs/heads | awk -F'\t' '$1 != "[gone]" { print $2 }' ;;
    online) git for-each-ref --format='%(refname:short)' refs/remotes/origin | sed -e '/^origin$/d' -e '/^origin\/HEAD$/d' -e 's|^origin/||' ;;
    *) list_branches local; list_branches online ;;
  esac | sort -u
}

# picker reload hook: wt --list <local|online|all>
if [[ ${1:-} == --list ]]; then
  list_branches "${2:-all}"
  exit
fi

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || fail "not inside a git repo ($PWD)"
root=$(dirname "$common")
repo=$(basename "$root")
if [[ $(git --git-dir="$common" rev-parse --is-bare-repository) == true ]]; then
  bare=true
  wtdir=$root
else
  bare=false
  wtdir=$root/.worktrees
fi

cd "$root" || fail "cannot cd to $root"
echo "fetching origin..."
git fetch -q --prune origin || fail "git fetch failed"
git symbolic-ref -q refs/remotes/origin/HEAD >/dev/null || git remote set-head origin --auto >/dev/null
base=$(git symbolic-ref --short refs/remotes/origin/HEAD) || fail "cannot find origin default branch"

branch=${1:-}
if [[ -z $branch ]]; then
  self=$(printf %q "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")")
  out=$(list_branches all | fzf --print-query --prompt="[$repo] all> " \
    --header=$'enter: pick | type a new name to create\nctrl-a: all | ctrl-l: local | ctrl-o: online' \
    --bind="ctrl-a:reload($self --list all)+change-prompt([$repo] all> )" \
    --bind="ctrl-l:reload($self --list local)+change-prompt([$repo] local> )" \
    --bind="ctrl-o:reload($self --list online)+change-prompt([$repo] online> )")
  rc=$?
  [[ $rc -le 1 ]] || exit 0
  branch=$(sed -n 2p <<<"$out")
  [[ -n $branch ]] || branch=$(sed -n 1p <<<"$out")
fi
[[ -n $branch ]] || exit 0
path="$wtdir/$branch"
[[ ! -e $path ]] || fail "$path already exists"

if [[ $bare == false ]]; then
  exclude=$common/info/exclude
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '/.worktrees/' "$exclude" 2>/dev/null || echo '/.worktrees/' >>"$exclude"
fi

if git show-ref -q --verify "refs/heads/$branch"; then
  git worktree add "$path" "$branch" || fail "git worktree add failed"
elif git show-ref -q --verify "refs/remotes/origin/$branch"; then
  git worktree add --track -b "$branch" "$path" "origin/$branch" || fail "git worktree add failed"
else
  git worktree add --no-track -b "$branch" "$path" "$base" || fail "git worktree add failed"
fi

cd "$path" || fail "cannot cd to $path"

# copy .env from the default-branch worktree (the main checkout in a normal
# repo), else any sibling that has one
if [[ $bare == true ]]; then main_env=$root/${base#origin/}/.env; else main_env=$root/.env; fi
if [[ ! -e .env ]]; then
  for src in "$main_env" "$wtdir"/*/.env; do
    [[ -f $src && $src != "$path/.env" ]] && { cp -p "$src" .env; echo "copied .env from $src"; break; }
  done
fi

if [[ -f composer.json ]]; then composer install --no-interaction || fail "composer install failed"; fi
if [[ -f pnpm-lock.yaml ]]; then pnpm install --frozen-lockfile || fail "pnpm install failed"
elif [[ -f package-lock.json ]]; then npm ci || fail "npm ci failed"
elif [[ -f yarn.lock ]]; then yarn install --frozen-lockfile || fail "yarn install failed"
fi
if [[ -f uv.lock ]]; then uv sync || fail "uv sync failed"; fi

herdr worktree open --cwd "$root" --path "$path" --label "$branch" --focus >/dev/null || fail "herdr worktree open failed"
